# Public host name of your Workchop server (its DNS must point at this machine).
# Caddy fetches an HTTPS certificate for it automatically. Use "localhost" to try it locally.
DOMAIN=office.example.com

# Password for the bundled Postgres database. Pick a long random one.
POSTGRES_PASSWORD=change-me

# Optional TURN relay (start it with: docker compose --profile turn up -d)
# TURN_URL=turn:office.example.com:3478
# TURN_USERNAME=workchop
# TURN_CREDENTIAL=another-long-random-password

# Optional Spotify listen-along: the Client ID of your app at https://developer.spotify.com/dashboard
# (redirect URI: https://<DOMAIN>/spotify-callback.html). See "Music and Spotify" in the README.
# SPOTIFY_CLIENT_ID=

# Optional Cloudflare TURN relay for calls through strict firewalls (dashboard: Realtime > TURN).
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_KEY_API_TOKEN=

# Header with each visitor's IP. Compose uses x-forwarded-for (set by the bundled Caddy). With the
# Cloudflare Tunnel override this is cf-connecting-ip automatically. Only use cf-connecting-ip
# yourself if the server can't be reached without going through Cloudflare (visitors could fake it).
# CLIENT_IP_HEADER=x-forwarded-for

# Only with deploy/cloudflare-tunnel.yml (Cloudflare Tunnel instead of Caddy, see the README):
# CLOUDFLARE_TUNNEL_TOKEN=
# COMPOSE_FILE=docker-compose.yml:deploy/cloudflare-tunnel.yml
