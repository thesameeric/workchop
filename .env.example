# Public host name of your Workchop server (its DNS must point at this machine).
# Caddy fetches an HTTPS certificate for it automatically. Use "localhost" to try it locally.
DOMAIN=office.example.com

# Password for the bundled Postgres database. Pick a long random one.
POSTGRES_PASSWORD=change-me

# Optional TURN relay (start it with: docker compose --profile turn up -d)
# TURN_URL=turn:office.example.com:3478
# TURN_USERNAME=workchop
# TURN_CREDENTIAL=another-long-random-password

# Optional Spotify listen-along: the Client ID of your app at https://developer.spotify.com/dashboard
# (redirect URI: https://<DOMAIN>/spotify-callback.html). See "Music and Spotify" in the README.
# SPOTIFY_CLIENT_ID=

# Weather from Open-Meteo, on by default. The free API is for non-commercial use only: for commercial
# use, set the key of a paid Open-Meteo plan, or turn the weather off. See "Weather" in the README.
# OPEN_METEO_API_KEY=
# WEATHER=off

# Optional sign-in (people can always join offices as guests). The address people open Workchop at
# defaults to https://<DOMAIN>; set PUBLIC_URL if that's different.
# PUBLIC_URL=https://office.example.com
# Google: a "Web application" OAuth client with the redirect URI https://<DOMAIN>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Apple: a Services ID with the return URL https://<DOMAIN>/api/auth/apple/callback, and a
# Sign in with Apple key (.p8). The key can be pasted with \n for line breaks, or base64-encoded.
# APPLE_CLIENT_ID=com.example.workchop.web
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Optional GitHub notifications for people who sign in. See "GitHub" in the README.
# An OAuth App with the callback URL https://<DOMAIN>/api/integrations/github/callback:
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# The key that encrypts saved GitHub tokens: run openssl rand -base64 32. Keep it: with a new key,
# everyone has to connect GitHub again.
# TOKEN_ENCRYPTION_KEY=

# Uploaded files (e.g. in chat) are stored in Postgres by default. To use an S3-compatible bucket
# instead (Cloudflare R2, AWS S3, MinIO), set these; files saved before keep working.
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_BUCKET=workchop
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# UPLOAD_MAX_BYTES=10485760
# UPLOADS_QUOTA_MB=1024

# Optional: delete chat conversations nobody has written in for this many days (default: keep them).
# CHAT_RETENTION_DAYS=365

# Optional Cloudflare TURN relay for calls through strict firewalls (dashboard: Realtime > TURN).
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_KEY_API_TOKEN=

# Header with each visitor's IP. Compose uses x-forwarded-for (set by the bundled Caddy). With the
# Cloudflare Tunnel override this is cf-connecting-ip automatically. Only use cf-connecting-ip
# yourself if the server can't be reached without going through Cloudflare (visitors could fake it).
# CLIENT_IP_HEADER=x-forwarded-for

# Approximate weather location from each visitor's connection. Only behind Cloudflare, with the "Add
# visitor location headers" Managed Transform turned on, and only if the server can't be reached
# without going through Cloudflare (visitors could fake their location otherwise).
# GEO_HEADERS=cloudflare

# Only with deploy/cloudflare-tunnel.yml (Cloudflare Tunnel instead of Caddy, see the README):
# CLOUDFLARE_TUNNEL_TOKEN=
# COMPOSE_FILE=docker-compose.yml:deploy/cloudflare-tunnel.yml
