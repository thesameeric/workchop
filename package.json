{
  "name": "workchop",
  "version": "0.1.0",
  "private": true,
  "description": "A 3D virtual office with proximity audio/video, customizable characters and an in-world office builder.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "aws4fetch": "^1.0.20",
    "cookie": "^2.0.1",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "oauth2-mock-server": "^9.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.4",
    "suncalc": "2.0.2",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
