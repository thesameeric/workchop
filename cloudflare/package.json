{
  "name": "workchop-cloudflare",
  "private": true,
  "type": "module",
  "description": "Runs Homeoffice's Docker image on Cloudflare Containers behind a small Worker.",
  "scripts": {
    "build": "npm --prefix .. run build",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.148.0"
  }
}
